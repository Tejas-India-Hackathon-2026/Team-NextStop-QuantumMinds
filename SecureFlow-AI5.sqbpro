-- ============================================================
-- 12. VIEW: COMPLETE TRANSACTION HISTORY
-- ============================================================

CREATE VIEW sender_transaction_history AS

SELECT

    t.transaction_id,

    u.user_id,

    u.name AS sender_name,

    u.initial_bank_balance,

    t.amount,

    t.transaction_time,

    t.payment_location,

    t.previous_location,

    t.sender_device_name,

    r.recipient_id,

    r.recipient_name,

    r.upi_id,

    t.recipient_device_name,

    r.recipient_location,

    r.recipient_type,

    CASE
        WHEN t.previous_connection = 1
        THEN 'YES - Previous Connection Exists'

        ELSE 'NO - No Previous Connection'
    END AS previous_connection_status,

    c.connection_type,

    c.previous_transaction_count,

    t.transaction_status

FROM transactions t

JOIN users u
ON t.user_id = u.user_id

JOIN recipients r
ON t.recipient_id = r.recipient_id

LEFT JOIN sender_recipient_connections c
ON t.user_id = c.user_id
AND t.recipient_id = c.recipient_id;


-- ============================================================
-- 13. VIEW: RECIPIENT TRANSACTION HISTORY
-- ============================================================

CREATE VIEW recipient_transaction_history AS

SELECT

    r.recipient_id,

    r.recipient_name,

    r.upi_id,

    r.recipient_device_name,

    t.transaction_id,

    u.name AS sender_name,

    t.amount,

    t.transaction_time,

    t.payment_location,

    t.transaction_status

FROM transactions t

JOIN users u
ON t.user_id = u.user_id

JOIN recipients r
ON t.recipient_id = r.recipient_id;


-- ============================================================
-- 14. INDEXES
-- ============================================================

CREATE INDEX idx_transactions_user
ON transactions(user_id);

CREATE INDEX idx_transactions_recipient
ON transactions(recipient_id);

CREATE INDEX idx_transactions_time
ON transactions(transaction_time);


-- ============================================================
-- 15. CHECK ALL SENDERS + INITIAL BALANCE
-- ============================================================

SELECT
    user_id,
    name,
    initial_bank_balance,
    total_transactions
FROM users
ORDER BY user_id;


-- ============================================================
-- 16. CHECK ALL 40 TRANSACTIONS
-- ============================================================

SELECT *
FROM sender_transaction_history
ORDER BY user_id, transaction_time;


-- ============================================================
-- 17. VERIFY EACH SENDER HAS EXACTLY 10 TRANSACTIONS
-- ============================================================

SELECT

    u.user_id,

    u.name AS sender_name,

    u.initial_bank_balance,

    COUNT(t.transaction_id) AS total_transaction_history

FROM users u

LEFT JOIN transactions t
ON u.user_id = t.user_id

GROUP BY
    u.user_id,
    u.name,
    u.initial_bank_balance

ORDER BY u.user_id;


-- ============================================================
-- END OF SECUREFLOW-AI DATABASE
-- ============================================================</sql><sql name="SQL 2*">SELECT * FROM sender_transaction_history;</sql><sql name="SQL 3*">-- ============================================================
-- SECUREFLOW-AI
-- COMPLETE SENDER + TRANSACTION + RECIPIENT HISTORY
-- ============================================================

SELECT

    -- ========================================================
    -- SENDER PERSONAL DETAILS
    -- ========================================================

    u.user_id AS sender_id,

    u.name AS sender_name,

    u.date_of_birth AS sender_date_of_birth,

    u.college_name AS sender_college,

    u.living_area AS sender_living_area,

    u.common_location AS sender_common_location,

    u.known_device AS sender_known_device,

    u.initial_bank_balance AS sender_initial_bank_balance,

    u.average_transaction AS sender_average_transaction,

    u.total_transactions AS sender_total_transactions,


    -- ========================================================
    -- TRANSACTION DETAILS
    -- ========================================================

    t.transaction_id,

    t.amount AS transaction_amount,

    t.transaction_time,

    t.transaction_status,

    t.payment_location,

    t.previous_location,


    -- ========================================================
    -- SENDER DEVICE USED FOR THIS TRANSACTION
    -- ========================================================

    t.sender_device_name AS transaction_sender_device,


    -- ========================================================
    -- RECIPIENT DETAILS
    -- ========================================================

    r.recipient_id,

    r.recipient_name,

    r.upi_id,

    r.recipient_type,

    r.recipient_location,

    r.recipient_device_name,


    -- ========================================================
    -- PREVIOUS CONNECTION DETAILS
    -- ========================================================

    CASE
        WHEN t.previous_connection = 1
        THEN 'YES - Previous Connection Exists'

        ELSE 'NO - No Previous Connection'
    END AS previous_connection_status,

    c.connection_type,

    c.previous_transaction_count,

    c.connection_notes,


    -- ========================================================
    -- BALANCE AFTER TRANSACTION
    --
    -- This calculates balance using ALL transactions
    -- before and including the current transaction.
    --
    -- IMPORTANT:
    -- PENDING / HELD transactions are NOT deducted here.
    -- Only SUCCESS transactions are deducted.
    -- ========================================================

    u.initial_bank_balance
    -
    COALESCE
    (
        (
            SELECT SUM(t2.amount)

            FROM transactions t2

            WHERE t2.user_id = t.user_id

            AND t2.transaction_status = 'SUCCESS'

            AND
            (
                t2.transaction_time &lt; t.transaction_time

                OR
                (
                    t2.transaction_time = t.transaction_time
                    AND t2.transaction_id &lt;= t.transaction_id
                )
            )
        ),
        0
    ) AS balance_after_transaction


FROM users u


-- ============================================================
-- CONNECT TRANSACTIONS
-- ============================================================

LEFT JOIN transactions t
ON u.user_id = t.user_id


-- ============================================================
-- CONNECT RECIPIENT
-- ============================================================

LEFT JOIN recipients r
ON t.recipient_id = r.recipient_id


-- ============================================================
-- CONNECT PREVIOUS CONNECTION INFORMATION
-- ============================================================

LEFT JOIN sender_recipient_connections c
ON t.user_id = c.user_id
AND t.recipient_id = c.recipient_id


-- ============================================================
-- ORDER
-- ============================================================

ORDER BY

    u.user_id,

    t.transaction_time;</sql><current_tab id="0"/></tab_sql></sqlb_project>
