<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="SecureFlow-AI5.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="4571"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="recipient_transaction_history" custom_title="0" dock_id="1" table="4,29:mainrecipient_transaction_history"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011e00ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">-- ============================================================
-- SECUREFLOW-AI
-- SQLITE DATABASE
-- 4 SENDERS + 4 RECIPIENTS
-- 10 TRANSACTIONS PER SENDER
-- TOTAL TRANSACTIONS = 40
-- ============================================================

PRAGMA foreign_keys = ON;


-- ============================================================
-- REMOVE OLD TABLES
-- ============================================================

DROP VIEW IF EXISTS sender_transaction_history;
DROP VIEW IF EXISTS recipient_transaction_history;

DROP TABLE IF EXISTS transactions;
DROP TABLE IF EXISTS sender_recipient_connections;
DROP TABLE IF EXISTS recipients;
DROP TABLE IF EXISTS users;


-- ============================================================
-- 1. SENDERS / USERS TABLE
-- ============================================================

CREATE TABLE users
(
    user_id TEXT PRIMARY KEY,

    name TEXT NOT NULL,

    date_of_birth TEXT,

    college_name TEXT,

    living_area TEXT NOT NULL,

    known_device TEXT NOT NULL,

    common_location TEXT,

    -- INITIAL BANK BALANCE
    initial_bank_balance REAL NOT NULL DEFAULT 0,

    average_transaction REAL DEFAULT 0,

    total_transactions INTEGER DEFAULT 0,

    created_at TEXT DEFAULT CURRENT_TIMESTAMP,

    CHECK (initial_bank_balance &gt;= 0)
);


-- ============================================================
-- 2. RECIPIENTS TABLE
-- ONLY 4 TOTAL RECIPIENTS
-- ============================================================

CREATE TABLE recipients
(
    recipient_id TEXT PRIMARY KEY,

    recipient_name TEXT NOT NULL,

    upi_id TEXT NOT NULL UNIQUE,

    recipient_device_name TEXT NOT NULL,

    recipient_location TEXT NOT NULL,

    recipient_type TEXT NOT NULL,

    created_at TEXT DEFAULT CURRENT_TIMESTAMP
);


-- ============================================================
-- 3. SENDER-RECIPIENT CONNECTION TABLE
-- ============================================================

CREATE TABLE sender_recipient_connections
(
    connection_id INTEGER PRIMARY KEY AUTOINCREMENT,

    user_id TEXT NOT NULL,

    recipient_id TEXT NOT NULL,

    previous_connection INTEGER NOT NULL DEFAULT 0,

    connection_type TEXT,

    previous_transaction_count INTEGER DEFAULT 0,

    connection_notes TEXT,

    FOREIGN KEY (user_id)
        REFERENCES users(user_id)
        ON DELETE CASCADE,

    FOREIGN KEY (recipient_id)
        REFERENCES recipients(recipient_id)
        ON DELETE CASCADE,

    UNIQUE(user_id, recipient_id),

    CHECK (previous_connection IN (0, 1)),

    CHECK (previous_transaction_count &gt;= 0)
);


-- ============================================================
-- 4. TRANSACTIONS TABLE
-- ============================================================

CREATE TABLE transactions
(
    transaction_id TEXT PRIMARY KEY,

    user_id TEXT NOT NULL,

    recipient_id TEXT NOT NULL,

    amount REAL NOT NULL,

    transaction_time TEXT NOT NULL,

    sender_device_name TEXT NOT NULL,

    recipient_device_name TEXT NOT NULL,

    payment_location TEXT NOT NULL,

    previous_location TEXT,

    previous_connection INTEGER NOT NULL DEFAULT 0,

    transaction_status TEXT NOT NULL DEFAULT 'SUCCESS',

    created_at TEXT DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (user_id)
        REFERENCES users(user_id)
        ON DELETE CASCADE,

    FOREIGN KEY (recipient_id)
        REFERENCES recipients(recipient_id)
        ON DELETE CASCADE,

    CHECK (amount &gt; 0),

    CHECK (previous_connection IN (0, 1)),

    CHECK
    (
        transaction_status IN
        (
            'SUCCESS',
            'PENDING',
            'FAILED',
            'BLOCKED',
            'HELD'
        )
    )
);


