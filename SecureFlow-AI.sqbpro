-- ============================================================
--                    SECUREFLOW-AI
--          BEHAVIOURAL UPI FRAUD DETECTION
-- ============================================================
--
-- ARCHITECTURE
--
-- New Transaction
--       ↓
-- Behaviour Engine / Backend / ML
--       ↓
-- 9 Behavioural Risk Factors
--       ↓
-- Risk Score 0 - 100
--       ↓
-- ┌────────────┬────────────┬─────────────┐
-- │ LOW        │ MEDIUM     │ HIGH        │
-- │ 0 - 40     │ 41 - 70    │ 71 - 100    │
-- │ ALLOW      │ ALERT      │ BLOCK       │
-- └────────────┴────────────┴─────────────┘
--                    ↓
--              MEDIUM ONLY
--                    ↓
--              HOLD / SLOW
--                    ↓
--             AUTHENTICATION
--                    ↓
--          INDEPENDENT SIGNALS
--                    ↓
--             DYNAMIC QUESTION
--                    ↓
--              FINAL ANSWER
--
--
-- ============================================================
-- RISK FACTORS
-- ============================================================
--
-- 1. Amount                          = 10
-- 2. Time                            = 7
-- 3. Frequency                       = 12
-- 4. New Device                      = 15
-- 5. Unusual Location                = 15
-- 6. Sudden Location Change          = 6
-- 7. Unknown Beneficiary             = 12
-- 8. No Previous Transaction         = 13
-- 9. Typical Amount With Beneficiary = 10
--
-- TOTAL = 100
--
-- ============================================================


PRAGMA foreign_keys = ON;


-- ============================================================
-- 1. DROP OLD OBJECTS
-- ============================================================

DROP VIEW IF EXISTS security_flow;
DROP VIEW IF EXISTS fraud_alerts;
DROP VIEW IF EXISTS risk_analysis;

DROP TABLE IF EXISTS final_answers;
DROP TABLE IF EXISTS dynamic_questions;
DROP TABLE IF EXISTS independent_signals;
DROP TABLE IF EXISTS authentication;
DROP TABLE IF EXISTS risk_analysis_data;
DROP TABLE IF EXISTS transactions;
DROP TABLE IF EXISTS beneficiaries;
DROP TABLE IF EXISTS users;
DROP TABLE IF EXISTS risk_factor_definitions;


-- ============================================================
-- 2. RISK FACTOR DEFINITIONS
-- ============================================================

CREATE TABLE risk_factor_definitions
(
    factor_id INTEGER PRIMARY KEY,

    factor_name TEXT NOT NULL UNIQUE,

    weight INTEGER NOT NULL,

    description TEXT NOT NULL,

    CHECK (weight &gt;= 0)
);


-- ============================================================
-- 3. YOUR EXACT 9 RISK FACTORS
-- ============================================================

INSERT INTO risk_factor_definitions
(
    factor_id,
    factor_name,
    weight,
    description
)
VALUES
(
    1,
    'Amount',
    10,
    'Unusual transaction amount'
),

(
    2,
    'Time',
    7,
    'Transaction occurs at an unusual time'
),

(
    3,
    'Frequency',
    12,
    'Unusually high transaction frequency'
),

(
    4,
    'New Device',
    15,
    'Transaction originates from a new device'
),

(
    5,
    'Unusual Location',
    15,
    'Transaction originates from an unusual location'
),

(
    6,
    'Sudden Location Change',
    6,
    'Sudden change from previous transaction location'
),

(
    7,
    'Unknown Beneficiary',
    12,
    'Beneficiary is unknown to the user'
),

(
    8,
    'No Previous Transaction',
    13,
    'No previous transaction exists with beneficiary'
),

(
    9,
    'Typical Amount With Beneficiary',
    10,
    'Transaction amount is not typical for this beneficiary'
);


-- ============================================================
-- 4. USERS
-- ============================================================

CREATE TABLE users
(
    user_id TEXT PRIMARY KEY,

    name TEXT NOT NULL,

    phone TEXT,

    average_transaction REAL DEFAULT 0,

    normal_start_time TEXT DEFAULT '08:00',

    normal_end_time TEXT DEFAULT '23:00',

    typical_daily_transactions INTEGER DEFAULT 0,

    known_device TEXT,

    common_location TEXT,

    created_at TEXT DEFAULT CURRENT_TIMESTAMP
);


