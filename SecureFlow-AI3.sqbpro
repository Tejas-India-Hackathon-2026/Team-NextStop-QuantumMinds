-- ============================================================
-- 4. BENEFICIARIES
-- 5 BENEFICIARIES FOR EACH USER
-- TOTAL = 20
-- ============================================================

CREATE TABLE beneficiaries
(
    beneficiary_id TEXT PRIMARY KEY,

    user_id TEXT NOT NULL,

    beneficiary_name TEXT NOT NULL,

    upi_id TEXT NOT NULL,

    recipient_type TEXT NOT NULL,

    living_area TEXT NOT NULL,

    transaction_count INTEGER DEFAULT 0,

    average_amount REAL DEFAULT 0,

    typical_amount REAL DEFAULT 0,

    last_transaction_time TEXT,

    is_known INTEGER DEFAULT 1,

    previously_used INTEGER DEFAULT 0,

    FOREIGN KEY (user_id)
        REFERENCES users(user_id)
        ON DELETE CASCADE,

    CHECK (transaction_count &gt;= 0),

    CHECK (average_amount &gt;= 0),

    CHECK (typical_amount &gt;= 0),

    CHECK (is_known IN (0,1)),

    CHECK (previously_used IN (0,1))
);


