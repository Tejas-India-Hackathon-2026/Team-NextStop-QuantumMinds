-- ============================================================
-- 5. TRANSACTIONS
-- ============================================================

CREATE TABLE transactions
(
    transaction_id TEXT PRIMARY KEY,

    user_id TEXT NOT NULL,

    beneficiary_id TEXT,

    amount REAL NOT NULL,

    transaction_time TEXT NOT NULL,

    transaction_frequency INTEGER DEFAULT 1,

    sender_device_id TEXT NOT NULL,

    payment_device TEXT NOT NULL,

    location TEXT NOT NULL,

    previous_location TEXT,

    recipient_type TEXT,

    beneficiary_name TEXT,

    beneficiary_typical_amount REAL,

    beneficiary_previously_used INTEGER DEFAULT 0,

    status TEXT DEFAULT 'PENDING',

    created_at TEXT DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (user_id)
        REFERENCES users(user_id)
        ON DELETE CASCADE,

    FOREIGN KEY (beneficiary_id)
        REFERENCES beneficiaries(beneficiary_id),

    CHECK (amount &gt;= 0),

    CHECK (beneficiary_previously_used IN (0,1)),

    CHECK
    (
        status IN
        (
            'PENDING',
            'SUCCESS',
            'FAILED',
            'BLOCKED',
            'HELD'
        )
    )
);


-- ============================================================
-- 6. TRANSACTION HISTORY
-- ============================================================

CREATE TABLE transaction_history
(
    history_id INTEGER PRIMARY KEY AUTOINCREMENT,

    transaction_id TEXT NOT NULL,

    user_id TEXT NOT NULL,

    beneficiary_id TEXT,

    transaction_time TEXT NOT NULL,

    amount REAL NOT NULL,

    sender_device_id TEXT NOT NULL,

    payment_device TEXT NOT NULL,

    location TEXT NOT NULL,

    previous_location TEXT,

    recipient_type TEXT,

    beneficiary_name TEXT,

    beneficiary_typical_amount REAL,

    beneficiary_previously_used INTEGER DEFAULT 0,

    transaction_status TEXT NOT NULL,

    FOREIGN KEY (transaction_id)
        REFERENCES transactions(transaction_id)
        ON DELETE CASCADE,

    FOREIGN KEY (user_id)
        REFERENCES users(user_id)
        ON DELETE CASCADE
);


-- ============================================================
-- 7. RISK ANALYSIS
-- ============================================================

CREATE TABLE risk_analysis_data
(
    risk_id INTEGER PRIMARY KEY AUTOINCREMENT,

    transaction_id TEXT NOT NULL UNIQUE,

    amount_flag INTEGER NOT NULL DEFAULT 0,

    time_flag INTEGER NOT NULL DEFAULT 0,

    frequency_flag INTEGER NOT NULL DEFAULT 0,

    new_device_flag INTEGER NOT NULL DEFAULT 0,

    unusual_location_flag INTEGER NOT NULL DEFAULT 0,

    sudden_location_change_flag INTEGER NOT NULL DEFAULT 0,

    unknown_beneficiary_flag INTEGER NOT NULL DEFAULT 0,

    no_previous_transaction_flag INTEGER NOT NULL DEFAULT 0,

    typical_amount_flag INTEGER NOT NULL DEFAULT 0,

    risk_score INTEGER GENERATED ALWAYS AS
    (
        amount_flag * 10 +
        time_flag * 7 +
        frequency_flag * 12 +
        new_device_flag * 15 +
        unusual_location_flag * 15 +
        sudden_location_change_flag * 6 +
        unknown_beneficiary_flag * 12 +
        no_previous_transaction_flag * 13 +
        typical_amount_flag * 10
    ) STORED,

    risk_level TEXT GENERATED ALWAYS AS
    (
        CASE

            WHEN
            (
                amount_flag * 10 +
                time_flag * 7 +
                frequency_flag * 12 +
                new_device_flag * 15 +
                unusual_location_flag * 15 +
                sudden_location_change_flag * 6 +
                unknown_beneficiary_flag * 12 +
                no_previous_transaction_flag * 13 +
                typical_amount_flag * 10
            ) &lt;= 40

            THEN 'LOW'

            WHEN
            (
                amount_flag * 10 +
                time_flag * 7 +
                frequency_flag * 12 +
                new_device_flag * 15 +
                unusual_location_flag * 15 +
                sudden_location_change_flag * 6 +
                unknown_beneficiary_flag * 12 +
                no_previous_transaction_flag * 13 +
                typical_amount_flag * 10
            ) &lt;= 70

            THEN 'MEDIUM'

            ELSE 'HIGH'

        END
    ) STORED,

    action TEXT GENERATED ALWAYS AS
    (
        CASE

            WHEN
            (
                amount_flag * 10 +
                time_flag * 7 +
                frequency_flag * 12 +
                new_device_flag * 15 +
                unusual_location_flag * 15 +
                sudden_location_change_flag * 6 +
                unknown_beneficiary_flag * 12 +
                no_previous_transaction_flag * 13 +
                typical_amount_flag * 10
            ) &lt;= 40

            THEN 'ALLOW'

            WHEN
            (
                amount_flag * 10 +
                time_flag * 7 +
                frequency_flag * 12 +
                new_device_flag * 15 +
                unusual_location_flag * 15 +
                sudden_location_change_flag * 6 +
                unknown_beneficiary_flag * 12 +
                no_previous_transaction_flag * 13 +
                typical_amount_flag * 10
            ) &lt;= 70

            THEN 'ALERT'

            ELSE 'BLOCK'

        END
    ) STORED,

    FOREIGN KEY (transaction_id)
        REFERENCES transactions(transaction_id)
        ON DELETE CASCADE,

    CHECK (amount_flag IN (0,1)),
    CHECK (time_flag IN (0,1)),
    CHECK (frequency_flag IN (0,1)),
    CHECK (new_device_flag IN (0,1)),
    CHECK (unusual_location_flag IN (0,1)),
    CHECK (sudden_location_change_flag IN (0,1)),
    CHECK (unknown_beneficiary_flag IN (0,1)),
    CHECK (no_previous_transaction_flag IN (0,1)),
    CHECK (typical_amount_flag IN (0,1))
);


-- ============================================================
-- 8. AUTHENTICATION
-- ============================================================

CREATE TABLE authentication
(
    authentication_id INTEGER PRIMARY KEY AUTOINCREMENT,

    transaction_id TEXT NOT NULL UNIQUE,

    authentication_required INTEGER DEFAULT 0,

    authentication_method TEXT,

    authentication_status TEXT DEFAULT 'NOT_REQUIRED',

    verified_at TEXT,

    FOREIGN KEY (transaction_id)
        REFERENCES transactions(transaction_id)
        ON DELETE CASCADE,

    CHECK (authentication_required IN (0,1)),

    CHECK
    (
        authentication_status IN
        (
            'NOT_REQUIRED',
            'PENDING',
            'SUCCESS',
            'FAILED'
        )
    )
);


-- ============================================================
-- 9. INDEPENDENT SECURITY SIGNALS
-- ============================================================

CREATE TABLE independent_signals
(
    signal_id INTEGER PRIMARY KEY AUTOINCREMENT,

    transaction_id TEXT NOT NULL UNIQUE,

    device_signal TEXT,

    location_signal TEXT,

    transaction_history_signal TEXT,

    beneficiary_signal TEXT,

    signal_result TEXT,

    FOREIGN KEY (transaction_id)
        REFERENCES transactions(transaction_id)
        ON DELETE CASCADE
);


-- ============================================================
-- 10. DYNAMIC QUESTIONS
-- ============================================================

CREATE TABLE dynamic_questions
(
    question_id INTEGER PRIMARY KEY AUTOINCREMENT,

    transaction_id TEXT NOT NULL,

    question TEXT NOT NULL,

    expected_answer TEXT,

    user_answer TEXT,

    status TEXT DEFAULT 'PENDING',

    FOREIGN KEY (transaction_id)
        REFERENCES transactions(transaction_id)
        ON DELETE CASCADE,

    CHECK
    (
        status IN
        (
            'PENDING',
            'CORRECT',
            'INCORRECT'
        )
    )
);


-- ============================================================
-- 11. FINAL ANSWERS
-- ============================================================

CREATE TABLE final_answers
(
    final_answer_id INTEGER PRIMARY KEY AUTOINCREMENT,

    transaction_id TEXT NOT NULL UNIQUE,

    final_decision TEXT NOT NULL,

    final_message TEXT,

    answered_at TEXT,

    FOREIGN KEY (transaction_id)
        REFERENCES transactions(transaction_id)
        ON DELETE CASCADE,

    CHECK
    (
        final_decision IN
        (
            'ALLOW',
            'BLOCK',
            'PENDING_AUTHENTICATION'
        )
    )
);


