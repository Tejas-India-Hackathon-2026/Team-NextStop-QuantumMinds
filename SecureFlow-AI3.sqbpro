-- ============================================================
-- CREATE THE COMPLETE TRANSACTION HISTORY VIEW
-- ============================================================

CREATE VIEW IF NOT EXISTS sender_transaction_history AS

SELECT
    t.transaction_id,
    u.user_id AS sender_id,
    u.name AS sender_name,
    t.amount,
    t.transaction_time,
    t.payment_location,
    t.previous_location,
    t.sender_device_name,

    r.recipient_id,
    r.recipient_name,
    r.upi_id AS recipient_upi_id,
    t.recipient_device_name,
    r.recipient_location,

    CASE
        WHEN t.previous_connection = 1 THEN 'YES'
        ELSE 'NO'
    END AS previous_connection,

    c.connection_type,
    c.previous_transaction_count,
    t.transaction_status

FROM transactions AS t

JOIN users AS u
ON t.user_id = u.user_id

JOIN recipients AS r
ON t.recipient_id = r.recipient_id

LEFT JOIN sender_recipient_connections AS c
ON t.user_id = c.user_id
AND t.recipient_id = c.recipient_id;


-- ============================================================
-- CHECK THE DATA
-- ============================================================

SELECT *
FROM sender_transaction_history
ORDER BY sender_id, transaction_time;</sql><current_tab id="1"/></tab_sql></sqlb_project>
