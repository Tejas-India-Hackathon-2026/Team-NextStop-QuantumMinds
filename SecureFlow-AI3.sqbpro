-- ============================================================
-- 14. TRANSACTION HISTORY
-- ============================================================

INSERT INTO transaction_history
(
    transaction_id,
    user_id,
    beneficiary_id,
    transaction_time,
    amount,
    sender_device_id,
    payment_device,
    location,
    previous_location,
    recipient_type,
    beneficiary_name,
    beneficiary_typical_amount,
    beneficiary_previously_used,
    transaction_status
)
SELECT
    transaction_id,
    user_id,
    beneficiary_id,
    transaction_time,
    amount,
    sender_device_id,
    payment_device,
    location,
    previous_location,
    recipient_type,
    beneficiary_name,
    beneficiary_typical_amount,
    beneficiary_previously_used,
    status
FROM transactions;


-- ============================================================
-- 15. RISK ANALYSIS VIEW
-- ============================================================

CREATE VIEW risk_analysis AS

SELECT

    t.transaction_id,

    t.user_id,

    u.name AS user_name,

    u.date_of_birth,

    u.college_name,

    u.living_area AS user_living_area,

    u.average_transaction,

    u.typical_daily_transactions,

    t.beneficiary_id,

    t.beneficiary_name,

    t.recipient_type,

    b.living_area AS beneficiary_area,

    t.amount,

    t.beneficiary_typical_amount,

    t.beneficiary_previously_used,

    t.transaction_frequency,

    t.transaction_time,

    t.sender_device_id,

    t.payment_device,

    t.location,

    t.previous_location,

    t.status,

    r.amount_flag,

    r.time_flag,

    r.frequency_flag,

    r.new_device_flag,

    r.unusual_location_flag,

    r.sudden_location_change_flag,

    r.unknown_beneficiary_flag,

    r.no_previous_transaction_flag,

    r.typical_amount_flag,

    r.risk_score,

    r.risk_level,

    r.action

FROM risk_analysis_data r

JOIN transactions t
    ON r.transaction_id = t.transaction_id

JOIN users u
    ON t.user_id = u.user_id

LEFT JOIN beneficiaries b
    ON t.beneficiary_id = b.beneficiary_id;


-- ============================================================
-- 16. FRAUD ALERT VIEW
-- ============================================================

CREATE VIEW fraud_alerts AS

SELECT

    transaction_id,

    user_name,

    amount,

    beneficiary_name,

    recipient_type,

    location,

    sender_device_id,

    risk_score,

    risk_level,

    action

FROM risk_analysis

WHERE risk_level IN ('MEDIUM','HIGH')

ORDER BY risk_score DESC;


-- ============================================================
-- 17. SECURITY FLOW VIEW
-- ============================================================

CREATE VIEW security_flow AS

SELECT

    r.transaction_id,

    r.user_name,

    r.amount,

    r.beneficiary_name,

    r.risk_score,

    r.risk_level,

    r.action,

    CASE

        WHEN r.risk_level = 'LOW'
        THEN 'ALLOW'

        WHEN r.risk_level = 'MEDIUM'
        THEN 'ALERT -&gt; HOLD/SLOW -&gt; AUTHENTICATION'

        WHEN r.risk_level = 'HIGH'
        THEN 'BLOCK'

    END AS security_flow,

    a.authentication_status,

    i.signal_result,

    q.status AS dynamic_question_status,

    f.final_decision

FROM risk_analysis r

LEFT JOIN authentication a
    ON r.transaction_id = a.transaction_id

LEFT JOIN independent_signals i
    ON r.transaction_id = i.transaction_id

LEFT JOIN dynamic_questions q
    ON r.transaction_id = q.transaction_id

LEFT JOIN final_answers f
    ON r.transaction_id = f.transaction_id;


-- ============================================================
-- 18. TEST QUERIES
-- ============================================================


-- SHOW ALL USERS

SELECT
    user_id,
    name,
    date_of_birth,
    college_name,
    living_area,
    average_transaction,
    typical_daily_transactions,
    known_device,
    common_location,
    total_transactions
FROM users;


-- SHOW ALL 20 BENEFICIARIES

SELECT
    user_id,
    beneficiary_id,
    beneficiary_name,
    upi_id,
    recipient_type,
    living_area,
    transaction_count,
    average_amount,
    typical_amount,
    previously_used
FROM beneficiaries
ORDER BY user_id, beneficiary_id;


-- SHOW COMPLETE TRANSACTION HISTORY

SELECT *
FROM transaction_history
ORDER BY transaction_time DESC;


-- SHOW ALL RISK ANALYSIS

SELECT
    transaction_id,
    user_name,
    amount,
    beneficiary_name,
    transaction_time,
    sender_device_id,
    location,
    risk_score,
    risk_level,
    action
FROM risk_analysis
ORDER BY risk_score DESC;


-- SHOW FRAUD ALERTS

SELECT *
FROM fraud_alerts;


-- SHOW COMPLETE SECURITY FLOW

SELECT *
FROM security_flow;


-- RISK SUMMARY

SELECT
    risk_level,
    COUNT(*) AS total_transactions
FROM risk_analysis
GROUP BY risk_level
ORDER BY
    CASE risk_level
        WHEN 'HIGH' THEN 1
        WHEN 'MEDIUM' THEN 2
        WHEN 'LOW' THEN 3
    END;</sql><sql name="SQL 2*">-- ============================================================
-- SECUREFLOW-AI DATABASE
-- SAFE VERSION FOR AN EXISTING SQLITE DATABASE
-- ============================================================

PRAGMA foreign_keys = ON;


-- ============================================================
-- 1. USERS / SENDERS TABLE
-- ============================================================

CREATE TABLE IF NOT EXISTS users (
    user_id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    living_area TEXT,
    sender_device_name TEXT,
    common_location TEXT,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
);


-- ============================================================
-- 2. RECIPIENTS TABLE
-- ============================================================

CREATE TABLE IF NOT EXISTS recipients (
    recipient_id TEXT PRIMARY KEY,
    recipient_name TEXT NOT NULL,
    upi_id TEXT NOT NULL UNIQUE,
    recipient_device_name TEXT NOT NULL,
    recipient_location TEXT,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP
);


-- ============================================================
-- 3. SENDER-RECIPIENT CONNECTION TABLE
-- ============================================================

CREATE TABLE IF NOT EXISTS sender_recipient_connections (
    connection_id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id TEXT NOT NULL,
    recipient_id TEXT NOT NULL,
    previous_connection INTEGER NOT NULL DEFAULT 0,
    connection_type TEXT,
    previous_transaction_count INTEGER DEFAULT 0,
    connection_notes TEXT,

    FOREIGN KEY (user_id) REFERENCES users(user_id),
    FOREIGN KEY (recipient_id) REFERENCES recipients(recipient_id),

    UNIQUE(user_id, recipient_id),

    CHECK (previous_connection IN (0, 1))
);


-- ============================================================
-- 4. TRANSACTIONS TABLE
-- ============================================================

CREATE TABLE IF NOT EXISTS transactions (
    transaction_id TEXT PRIMARY KEY,
    user_id TEXT NOT NULL,
    recipient_id TEXT NOT NULL,
    amount REAL NOT NULL,
    transaction_time TEXT NOT NULL,
    payment_location TEXT NOT NULL,
    previous_location TEXT,
    sender_device_name TEXT NOT NULL,
    recipient_device_name TEXT NOT NULL,
    previous_connection INTEGER NOT NULL DEFAULT 0,
    transaction_status TEXT NOT NULL DEFAULT 'SUCCESS',
    created_at TEXT DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (user_id) REFERENCES users(user_id),
    FOREIGN KEY (recipient_id) REFERENCES recipients(recipient_id),

    CHECK (amount &gt; 0),
    CHECK (previous_connection IN (0, 1))
);


