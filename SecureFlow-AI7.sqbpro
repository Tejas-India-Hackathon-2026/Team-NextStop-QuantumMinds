row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="recipients" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="75"/><column index="2" value="143"/><column index="3" value="175"/><column index="4" value="215"/><column index="5" value="110"/><column index="6" value="91"/><column index="7" value="159"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="security_answers" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="66"/><column index="2" value="52"/><column index="3" value="76"/><column index="4" value="109"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="transactions" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="90"/><column index="2" value="52"/><column index="3" value="77"/><column index="4" value="55"/><column index="5" value="135"/><column index="6" value="239"/><column index="7" value="215"/><column index="8" value="111"/><column index="9" value="109"/><column index="10" value="126"/><column index="11" value="116"/><column index="12" value="67"/><column index="13" value="82"/><column index="14" value="159"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- ============================================================
-- SECUREFLOW-AI
-- COMPLETE SQLITE DATABASE
-- VERSION 8.0
--
-- FEATURES
-- ============================================================
-- 4 USERS
-- 4 RECIPIENTS
-- 40 HISTORICAL TRANSACTIONS
-- ₹100,000 STARTING BALANCE PER USER
-- LIVE BALANCE SUPPORT
-- FRAUD / RISK SUPPORT
-- DYNAMIC SECURITY QUESTIONS
-- PERSONAL VERIFICATION QUESTIONS
-- USER-SPECIFIC EXPECTED ANSWERS
-- CHALLENGE SESSIONS
-- TRANSACTION HISTORY
-- ACCOUNT SUMMARY
-- ADMIN / ANALYTICS SUPPORT
-- ============================================================


PRAGMA foreign_keys = ON;


-- ============================================================
-- SECTION 1
-- REMOVE OLD DATABASE OBJECTS
-- ============================================================

DROP VIEW IF EXISTS sender_transaction_history;
DROP VIEW IF EXISTS recipient_transaction_history;
DROP VIEW IF EXISTS user_account_summary;
DROP VIEW IF EXISTS dynamic_question_data;
DROP VIEW IF EXISTS fraud_alerts;
DROP VIEW IF EXISTS live_monitor_data;

DROP TRIGGER IF EXISTS trg_update_user_statistics;

DROP TABLE IF EXISTS challenge_sessions;
DROP TABLE IF EXISTS security_answers;
DROP TABLE IF EXISTS security_questions;
DROP TABLE IF EXISTS transactions;
DROP TABLE IF EXISTS sender_recipient_connections;
DROP TABLE IF EXISTS recipients;
DROP TABLE IF EXISTS users;


-- ============================================================
-- SECTION 2
-- USERS TABLE
-- ============================================================

CREATE TABLE users
(
    user_id TEXT PRIMARY KEY,

    name TEXT NOT NULL,

    date_of_birth TEXT NOT NULL,

    college_name TEXT,

    living_area TEXT NOT NULL,

    known_device TEXT NOT NULL,

    common_location TEXT NOT NULL,

    initial_bank_balance REAL NOT NULL DEFAULT 100000,

    current_bank_balance REAL NOT NULL DEFAULT 100000,

    average_transaction REAL NOT NULL DEFAULT 0,

    total_transactions INTEGER NOT NULL DEFAULT 0,

    created_at TEXT DEFAULT CURRENT_TIMESTAMP,

    CHECK (initial_bank_balance &gt;= 0),

    CHECK (current_bank_balance &gt;= 0),

    CHECK (average_transaction &gt;= 0),

    CHECK (total_transactions &gt;= 0)
);


-- ============================================================
-- SECTION 3
-- RECIPIENTS TABLE
-- ============================================================

CREATE TABLE recipients
(
    recipient_id TEXT PRIMARY KEY,

    recipient_name TEXT NOT NULL,

    upi_id TEXT NOT NULL UNIQUE,

    recipient_device_name TEXT NOT NULL,

    recipient_location TEXT NOT NULL,

    recipient_type TEXT NOT NULL,

    created_at TEXT DEFAULT CURRENT_TIMESTAMP
);


-- ============================================================
-- SECTION 4
-- SENDER-RECIPIENT CONNECTIONS
-- ============================================================

CREATE TABLE sender_recipient_connections
(
    connection_id INTEGER PRIMARY KEY AUTOINCREMENT,

    user_id TEXT NOT NULL,

    recipient_id TEXT NOT NULL,

    previous_connection INTEGER NOT NULL DEFAULT 0,

    connection_type TEXT,

    previous_transaction_count INTEGER NOT NULL DEFAULT 0,

    connection_notes TEXT,

    FOREIGN KEY (user_id)
        REFERENCES users(user_id)
        ON DELETE CASCADE,

    FOREIGN KEY (recipient_id)
        REFERENCES recipients(recipient_id)
        ON DELETE CASCADE,

    UNIQUE(user_id, recipient_id),

    CHECK (previous_connection IN (0,1)),

    CHECK (previous_transaction_count &gt;= 0)
);


-- ============================================================
-- SECTION 5
-- TRANSACTIONS TABLE
-- ============================================================

CREATE TABLE transactions
(
    transaction_id TEXT PRIMARY KEY,

    user_id TEXT NOT NULL,

    recipient_id TEXT NOT NULL,

    amount REAL NOT NULL,

    transaction_time TEXT NOT NULL,

    sender_device_name TEXT NOT NULL,

    recipient_device_name TEXT NOT NULL,

    payment_location TEXT NOT NULL,

    previous_location TEXT,

    previous_connection INTEGER NOT NULL DEFAULT 0,

    transaction_status TEXT NOT NULL DEFAULT 'SUCCESS',

    risk_score INTEGER NOT NULL DEFAULT 0,

    risk_decision TEXT NOT NULL DEFAULT 'ALLOW',

    created_at TEXT DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (user_id)
        REFERENCES users(user_id)
        ON DELETE CASCADE,

    FOREIGN KEY (recipient_id)
        REFERENCES recipients(recipient_id)
        ON DELETE CASCADE,

    CHECK (amount &gt; 0),

    CHECK (previous_connection IN (0,1)),

    CHECK
    (
        transaction_status IN
        (
            'SUCCESS',
            'PENDING',
            'FAILED',
            'BLOCKED',
            'HELD'
        )
    ),

    CHECK
    (
        risk_score &gt;= 0
        AND
        risk_score &lt;= 100
    ),

    CHECK
    (
        risk_decision IN
        (
            'ALLOW',
            'ALERT',
            'BLOCK'
        )
    )
);


-- ============================================================
-- SECTION 6
-- DYNAMIC SECURITY QUESTIONS
-- ============================================================

CREATE TABLE security_questions
(
    question_id INTEGER PRIMARY KEY AUTOINCREMENT,

    question_code TEXT NOT NULL UNIQUE,

    question_text TEXT NOT NULL,

    risk_factor TEXT NOT NULL,

    expected_answer_type TEXT NOT NULL DEFAULT 'TEXT',

    active INTEGER NOT NULL DEFAULT 1,

    CHECK (active IN (0,1))
);


-- ============================================================
-- SECTION 7
-- USER-SPECIFIC SECURITY ANSWERS
-- ============================================================

CREATE TABLE security_answers
(
    answer_id INTEGER PRIMARY KEY AUTOINCREMENT,

    user_id TEXT NOT NULL,

    question_id INTEGER NOT NULL,

    expected_answer TEXT NOT NULL,

    FOREIGN KEY (user_id)
        REFERENCES users(user_id)
        ON DELETE CASCADE,

    FOREIGN KEY (question_id)
        REFERENCES security_questions(question_id)
        ON DELETE CASCADE,

    UNIQUE(user_id, question_id)
);


-- ============================================================
-- SECTION 8
-- CHALLENGE SESSIONS
-- ============================================================

CREATE TABLE challenge_sessions
(
    challenge_id TEXT PRIMARY KEY,

    user_id TEXT NOT NULL,

    transaction_id TEXT NOT NULL,

    question_id INTEGER NOT NULL,

    expected_answer TEXT NOT NULL,

    created_at TEXT NOT NULL,

    expires_at TEXT NOT NULL,

    status TEXT NOT NULL DEFAULT 'PENDING',

    FOREIGN KEY (user_id)
        REFERENCES users(user_id)
        ON DELETE CASCADE,

    FOREIGN KEY (question_id)
        REFERENCES security_questions(question_id)
        ON DELETE CASCADE,

    CHECK
    (
        status IN
        (
            'PENDING',
            'VERIFIED',
            'FAILED',
            'EXPIRED'
        )
    )
);


