-- ============================================================
-- SECTION 19
-- DYNAMIC SECURITY QUESTIONS
-- ============================================================
--
-- These questions are deliberately mixed:
--
-- 1. Personal information
-- 2. Location
-- 3. College
-- 4. Device
-- 5. Transaction history
-- 6. Recipient verification
-- 7. Fraud-specific verification
--
-- FastAPI can randomly/selectively choose questions.
-- ============================================================

INSERT INTO security_questions
(
    question_code,
    question_text,
    risk_factor,
    expected_answer_type
)
VALUES

(
    'DOB_VERIFY',
    'What is your date of birth?',
    'Personal identity verification',
    'DATE'
),

(
    'COLLEGE_VERIFY',
    'What is the name of your college?',
    'Personal identity verification',
    'TEXT'
),

(
    'AREA_VERIFY',
    'Which area do you usually live in?',
    'Location verification',
    'TEXT'
),

(
    'LOCATION_VERIFY',
    'Which city or location do you normally make payments from?',
    'Usual location verification',
    'TEXT'
),

(
    'DEVICE_VERIFY',
    'Which device do you normally use for payments?',
    'Device verification',
    'TEXT'
),

(
    'RECENT_PLACE_VERIFY',
    'Which location did you most recently use for a payment?',
    'Recent location verification',
    'TEXT'
),

(
    'RECIPIENT_VERIFY',
    'Do you recognize the recipient of this payment?',
    'Recipient verification',
    'YES_NO'
),

(
    'HISTORY_VERIFY',
    'Have you previously made payments to this recipient?',
    'Transaction history verification',
    'YES_NO'
),

(
    'AMOUNT_VERIFY',
    'Did you personally enter and authorize this payment amount?',
    'Amount verification',
    'YES_NO'
),

(
    'TIME_VERIFY',
    'Did you personally initiate this payment at this time?',
    'Time anomaly',
    'YES_NO'
),

(
    'TRAVEL_VERIFY',
    'Did you recently travel to the location from which this payment is being made?',
    'Location anomaly',
    'YES_NO'
),

(
    'DEVICE_CONTROL_VERIFY',
    'Do you recognize and control the device being used for this payment?',
    'New device',
    'YES_NO'
);


