-- ============================================================
-- SECTION 24
-- INDEXES
-- ============================================================

CREATE INDEX idx_transactions_user
ON transactions(user_id);

CREATE INDEX idx_transactions_recipient
ON transactions(recipient_id);

CREATE INDEX idx_transactions_time
ON transactions(transaction_time);

CREATE INDEX idx_transactions_status
ON transactions(transaction_status);

CREATE INDEX idx_transactions_risk
ON transactions(risk_score);

CREATE INDEX idx_transactions_decision
ON transactions(risk_decision);

CREATE INDEX idx_connections_user
ON sender_recipient_connections(user_id);

CREATE INDEX idx_connections_recipient
ON sender_recipient_connections(recipient_id);

CREATE INDEX idx_security_answers_user
ON security_answers(user_id);

CREATE INDEX idx_security_questions_active
ON security_questions(active);

CREATE INDEX idx_challenge_user
ON challenge_sessions(user_id);

CREATE INDEX idx_challenge_transaction
ON challenge_sessions(transaction_id);


-- ============================================================
-- SECTION 25
-- SENDER TRANSACTION HISTORY VIEW
-- ============================================================

CREATE VIEW sender_transaction_history AS

SELECT

    t.transaction_id,

    u.user_id,

    u.name AS sender_name,

    u.date_of_birth,

    u.college_name,

    u.living_area,

    u.known_device,

    u.common_location,

    u.initial_bank_balance,

    u.current_bank_balance,

    t.amount,

    t.transaction_time,

    t.payment_location,

    t.previous_location,

    t.sender_device_name,

    r.recipient_id,

    r.recipient_name,

    r.upi_id,

    t.recipient_device_name,

    r.recipient_location,

    r.recipient_type,

    CASE

        WHEN t.previous_connection = 1
        THEN 'YES - Previous Connection Exists'

        ELSE 'NO - No Previous Connection'

    END AS previous_connection_status,

    c.connection_type,

    c.previous_transaction_count,

    t.transaction_status,

    t.risk_score,

    t.risk_decision,

    t.created_at

FROM transactions t

JOIN users u
ON t.user_id = u.user_id

JOIN recipients r
ON t.recipient_id = r.recipient_id

LEFT JOIN sender_recipient_connections c

ON t.user_id = c.user_id

AND t.recipient_id = c.recipient_id;


-- ============================================================
-- SECTION 26
-- RECIPIENT TRANSACTION HISTORY VIEW
-- ============================================================

CREATE VIEW recipient_transaction_history AS

SELECT

    r.recipient_id,

    r.recipient_name,

    r.upi_id,

    r.recipient_device_name,

    r.recipient_location,

    r.recipient_type,

    t.transaction_id,

    u.user_id,

    u.name AS sender_name,

    t.amount,

    t.transaction_time,

    t.payment_location,

    t.transaction_status,

    t.risk_score,

    t.risk_decision

FROM transactions t

JOIN users u
ON t.user_id = u.user_id

JOIN recipients r
ON t.recipient_id = r.recipient_id;


-- ============================================================
-- SECTION 27
-- USER ACCOUNT SUMMARY
-- ============================================================

CREATE VIEW user_account_summary AS

SELECT

    u.user_id,

    u.name,

    u.date_of_birth,

    u.college_name,

    u.living_area,

    u.known_device,

    u.common_location,

    u.initial_bank_balance,

    u.current_bank_balance,

    u.average_transaction,

    u.total_transactions,

    COALESCE
    (
        (
            SELECT SUM(t.amount)

            FROM transactions t

            WHERE t.user_id = u.user_id

            AND t.transaction_status = 'SUCCESS'
        ),
        0
    ) AS historical_successful_amount,

    COALESCE
    (
        (
            SELECT COUNT(*)

            FROM transactions t

            WHERE t.user_id = u.user_id

            AND t.transaction_status = 'SUCCESS'
        ),
        0
    ) AS historical_successful_transactions,

    COALESCE
    (
        (
            SELECT COUNT(*)

            FROM transactions t

            WHERE t.user_id = u.user_id

            AND t.transaction_status = 'HELD'
        ),
        0
    ) AS held_transactions,

    COALESCE
    (
        (
            SELECT COUNT(*)

            FROM transactions t

            WHERE t.user_id = u.user_id

            AND t.transaction_status = 'BLOCKED'
        ),
        0
    ) AS blocked_transactions,

    COALESCE
    (
        (
            SELECT SUM(t.amount)

            FROM transactions t

            WHERE t.user_id = u.user_id

            AND t.transaction_status = 'SUCCESS'
        ),
        0
    ) AS total_money_sent

FROM users u;


-- ============================================================
-- SECTION 28
-- DYNAMIC QUESTION DATA
-- ============================================================

CREATE VIEW dynamic_question_data AS

SELECT

    u.user_id,

    u.name,

    q.question_id,

    q.question_code,

    q.question_text,

    q.risk_factor,

    q.expected_answer_type,

    a.expected_answer

FROM users u

CROSS JOIN security_questions q

LEFT JOIN security_answers a

ON u.user_id = a.user_id

AND q.question_id = a.question_id

WHERE q.active = 1;


-- ============================================================
-- SECTION 29
-- FRAUD ALERTS VIEW
-- ============================================================

CREATE VIEW fraud_alerts AS

SELECT

    t.transaction_id,

    t.user_id,

    u.name AS user_name,

    t.recipient_id,

    r.recipient_name,

    r.upi_id,

    t.amount,

    t.transaction_time,

    t.payment_location,

    t.previous_location,

    t.sender_device_name,

    t.transaction_status,

    t.risk_score,

    t.risk_decision,

    CASE

        WHEN t.risk_score &gt;= 70
        THEN 'HIGH'

        WHEN t.risk_score &gt;= 40
        THEN 'MEDIUM'

        ELSE 'LOW'

    END AS risk_level

FROM transactions t

JOIN users u
ON t.user_id = u.user_id

JOIN recipients r
ON t.recipient_id = r.recipient_id

WHERE

    t.risk_score &gt;= 40

    OR

    t.transaction_status IN
    (
        'HELD',
        'BLOCKED',
        'PENDING'
    );


-- ============================================================
-- SECTION 30
-- LIVE MONITOR VIEW
-- ============================================================

CREATE VIEW live_monitor_data AS

SELECT

    t.transaction_id,

    t.user_id,

    u.name AS sender_name,

    t.recipient_id,

    r.recipient_name,

    r.upi_id,

    t.amount,

    t.transaction_time,

    t.sender_device_name,

    t.recipient_device_name,

    t.payment_location,

    t.previous_location,

    t.previous_connection,

    t.transaction_status,

    t.risk_score,

    t.risk_decision,

    u.current_bank_balance

FROM transactions t

JOIN users u
ON t.user_id = u.user_id

JOIN recipients r
ON t.recipient_id = r.recipient_id

ORDER BY
    t.transaction_time DESC;


-- ============================================================
-- SECTION 31
-- DATABASE VERIFICATION
-- ============================================================


-- CHECK USERS

SELECT

    user_id,

    name,

    date_of_birth,

    college_name,

    living_area,

    known_device,

    common_location,

    current_bank_balance

FROM users

ORDER BY user_id;


-- CHECK RECIPIENTS

SELECT *

FROM recipients

ORDER BY recipient_id;


-- CHECK CONNECTIONS

SELECT *

FROM sender_recipient_connections

ORDER BY user_id, recipient_id;


-- CHECK TRANSACTION COUNT

SELECT

    COUNT(*) AS total_transactions

FROM transactions;


-- CHECK ALL TRANSACTIONS

SELECT *

FROM sender_transaction_history

ORDER BY
    user_id,
    transaction_time;


-- CHECK DYNAMIC QUESTIONS

SELECT *

FROM dynamic_question_data

WHERE user_id = 'U001'

ORDER BY question_id;


-- CHECK ALL USER QUESTIONS

SELECT

    user_id,

    name,

    question_code,

    question_text,

    expected_answer_type,

    expected_answer

FROM dynamic_question_data

ORDER BY
    user_id,
    question_id;


-- CHECK ACCOUNT SUMMARY

SELECT *

FROM user_account_summary

ORDER BY user_id;


-- CHECK FRAUD ALERTS

SELECT *

FROM fraud_alerts

ORDER BY risk_score DESC;


-- CHECK LIVE MONITOR

SELECT *

FROM live_monitor_data;


